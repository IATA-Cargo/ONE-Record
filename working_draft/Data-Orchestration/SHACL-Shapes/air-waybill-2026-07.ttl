  sh:property [
    sh:path cargo:rcp;
    sh:maxCount 1;
  ], [
    sh:path cargo:rcp;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rcp;
    sh:severity sh:Warning;
