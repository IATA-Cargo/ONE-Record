  ], [
    sh:path cargo:rateClassCodeBasic;
    sh:in (
      rateClassCode:C
      rateClassCode:M
      rateClassCode:N
      rateClassCode:Q
      rateClassCode:U
    );
  ];
  sh:property [
    sh:path cargo:rateGrossWeight;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateGrossWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
