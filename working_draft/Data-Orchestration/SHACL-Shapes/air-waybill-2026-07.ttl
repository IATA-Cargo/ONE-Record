    sh:maxCount 1;
  ], [
    sh:path cargo:uldRateClassType;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:uldRateClassType;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:uldReferences;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
