  sh:property [
    sh:path cargo:lastName;
    sh:maxCount 1;
  ], [
    sh:path cargo:lastName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:Party a sh:NodeShape;
  sh:property [
    sh:path cargo:accountNumbers;
    sh:maxCount 1;
  ], [
    sh:path cargo:accountNumbers;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:accountNumbers;
    sh:node shwb:AccountNumber;
  ];
  sh:property [
    sh:path cargo:otherIdentifiers;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:otherIdentifiers;
    sh:node shwb:OtherIdentifier;
  ];
  sh:property [
    sh:path cargo:partyDetails;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyDetails;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyDetails;
    sh:node shwb:Company;
  ];
  sh:property [
    sh:path cargo:partyRole;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyRole;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyRole;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:Piece a sh:NodeShape;
  sh:property [
    sh:path [ sh:zeroOrMorePath cargo:containedPieces ];
    sh:qualifiedMinCount 1;
    sh:qualifiedValueShape [ sh:or ( [ sh:property [
      sh:path ( cargo:contentProducts cargo:hsCode );
      sh:minCount 1;
    ] ] [ sh:property [
      sh:path ( cargo:containedItems cargo:ofProduct cargo:hsCode );
      sh:minCount 1;
    ] ] ) ];
    sh:severity sh:Warning;
    sh:message "No HS code connected to Piece";
  ];
  sh:property [
    sh:path cargo:contentProductionCountry;
    sh:maxCount 1;
  ], [
    sh:path cargo:contentProductionCountry;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contentProductionCountry;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:contentProducts;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contentProducts;
    sh:node shwb:Product;
  ];
  sh:property [
    sh:path cargo:dimensions;
    sh:maxCount 1;
  ], [
    sh:path cargo:dimensions;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:dimensions;
    sh:node shwb:P_Dimensions;
  ];
  sh:property [
    sh:path cargo:goodsDescription;
    sh:maxCount 1;
  ], [
    sh:path cargo:goodsDescription;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:slac;
    sh:maxCount 1;
  ], [
    sh:path cargo:slac;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:specialHandlingCodes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:specialHandlingCodes;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:containedItems;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:containedItems;
    sh:node shwb:Item;
  ];
  sh:property [
    sh:path cargo:ofShipment;
    sh:minCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to shipment missing";
  ].

shwb:LineItemPiece a sh:NodeShape;
  sh:property [
    sh:path cargo:dimensions;
    sh:maxCount 1;
  ], [
    sh:path cargo:dimensions;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:dimensions;
    sh:node shwb:P_Dimensions;
  ];
  sh:property [
    sh:path cargo:ofShipment;
    sh:minCount 1;
    sh:severity sh:Info;
    sh:message "Line item piece not connected to a shipment";
  ].

shwb:Item a sh:NodeShape;
  sh:property [
    sh:path cargo:ofProduct;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:ofProduct;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ofProduct;
    sh:node shwb:Product;
  ];
  sh:property [
    sh:path cargo:productionCountry;
    sh:maxCount 1;
  ], [
    sh:path cargo:productionCountry;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:productionCountry;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:Product a sh:NodeShape;
  sh:property [
    sh:path cargo:commodityItemNumber;
    sh:maxCount 1;
  ], [
    sh:path cargo:commodityItemNumber;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:hsCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:hsCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:hsCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:Shipment a sh:NodeShape;
  sh:node [
    sh:or ( [ sh:property [
      sh:path cargo:goodsDescription;
      sh:minCount 1;
    ] ] [ sh:property [
      sh:path [ sh:oneOrMorePath cargo:pieces ];
      sh:minCount 1;
      sh:node [ sh:property [
        sh:path cargo:goodsDescription;
        sh:minCount 1;
      ] ];
    ] ] );
    sh:message "No goodsDescription on either shipment or piece";
  ];
  sh:property [
    sh:path cargo:customsInformation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:customsInformation;
    sh:node shwb:CustomsInformation;
  ];
  sh:property [
    sh:path cargo:goodsDescription;
    sh:maxCount 1;
  ], [
    sh:path cargo:goodsDescription;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:insurance;
    sh:maxCount 1;
  ], [
    sh:path cargo:insurance;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:insurance;
    sh:node shwb:Insurance;
  ];
  sh:property [
    sh:path cargo:involvedParties;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:involvedParties;
    sh:node shwb:Party;
  ];
  sh:property [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:SHP;
    ];
    sh:qualifiedMinCount 1;
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
  ], [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:CNE;
    ];
    sh:qualifiedMinCount 1;
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
  ], [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:AGT;
    ];
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
  ], [
    sh:path cargo:involvedParties;
    sh:or ( [ sh:not [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:AGT;
    ] ] [
      sh:path ( cargo:partyDetails cargo:iataCargoAgentCode );
      sh:minCount 1;
      sh:maxCount 1;
    ] );
    sh:message "Agent party (AGT) requires exactly one partyDetails/iataCargoAgentCode";
  ], [
    sh:path cargo:involvedParties;
    sh:or ( [ sh:not [
      sh:path cargo:partyRole;
      sh:minCount 1;
      sh:in ( participantIdentifiers:SHP participantIdentifiers:CNE );
    ] ] [
      sh:path ( cargo:partyDetails cargo:basedAtLocation cargo:address );
      sh:node [ sh:property [
        sh:path cargo:country;
        sh:minCount 1;
      ] ];
    ] );
    sh:message "Shipper (SHP) and consignee (CNE) address requires a country";
  ], [
    sh:path cargo:involvedParties;
    sh:or ( [ sh:not [
      sh:path cargo:partyRole;
      sh:minCount 1;
      sh:in ( participantIdentifiers:SHP participantIdentifiers:CNE participantIdentifiers:NFY );
    ] ] [
      sh:path ( cargo:partyDetails cargo:basedAtLocation cargo:address cargo:streetAddressLines );
      sh:minCount 1;
    ] );
    sh:message "Shipper (SHP), consignee (CNE) and notify (NFY) address requires a street address line";
  ], [
    sh:path cargo:involvedParties;
    sh:severity sh:Warning;
    sh:or ( [
      sh:path cargo:partyRole;
      sh:minCount 1;
      sh:in ( participantIdentifiers:SHP participantIdentifiers:CNE );
    ] [
      sh:path ( cargo:partyDetails cargo:basedAtLocation cargo:address );
      sh:node [ sh:property [
        sh:path cargo:country;
        sh:minCount 1;
      ] ];
    ] );
    sh:message "Party address (e.g. AGT) should have a country";
  ];;
  sh:property [
    sh:path cargo:pieces;
    sh:minCount 1;
  ], [
    sh:path cargo:pieces;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:pieces;
    sh:node shwb:Piece;
  ];
  sh:property [
    sh:path cargo:textualHandlingInstructions;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:totalGrossWeight;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:totalGrossWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:totalGrossWeight;
    sh:node shwb:Value;
  ];
  sh:property [
    sh:path cargo:totalVolume;
    sh:maxCount 1;
  ], [
    sh:path cargo:totalVolume;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:totalVolume;
    sh:node shwb:Value;
  ];
  sh:property [
    sh:path cargo:securityDeclarations;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:securityDeclarations;
    sh:node shwb:SecurityDeclaration;
  ];
  sh:property [
    sh:path cargo:waybill;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to waybill missing";
  ].

shwb:TransportMeans a sh:NodeShape;
  sh:property [
    sh:path cargo:vehicleRegistration;
    sh:maxCount 1;
  ], [
    sh:path cargo:vehicleRegistration;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:vehicleSize;
    sh:maxCount 1;
  ], [
    sh:path cargo:vehicleSize;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:vehicleType;
    sh:maxCount 1;
  ], [
    sh:path cargo:vehicleType;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:vehicleType;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:RoutingTransportMovement a sh:NodeShape;
  sh:property [
    sh:path cargo:arrivalLocation;
    sh:minCount 1;
  ];
  sh:property [
    sh:path cargo:movementTimes;
    sh:qualifiedValueShape [
      sh:path cargo:movementMilestone;
      sh:hasValue movementIndicators:SD;
    ];
    sh:qualifiedMinCount 1;
  ];
  sh:property [
    sh:path ( cargo:operatingParties cargo:partyDetails cargo:airlineCode );
    sh:minCount 1;
  ].

shwb:TransportMovement a sh:NodeShape;
  sh:property [
    sh:path cargo:arrivalLocation;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:arrivalLocation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:arrivalLocation;
    sh:node shwb:AIR_Location;
  ];
  sh:property [
    sh:path cargo:departureLocation;
    sh:maxCount 1;
  ], [
    sh:path cargo:departureLocation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:departureLocation;
    sh:node shwb:AIR_Location;
  ];
  sh:property [
    sh:path cargo:modeCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:modeCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:modeCode;
    sh:in (
      modeCode:AIR_TRANSPORT
      modeCode:FIXED_TRANSPORT_INSTALLATION
      modeCode:INLAND_WATER_TRANSPORT
      modeCode:MARITIME_TRANSPORT
      modeCode:MULTIMODAL_TRANSPORT
      modeCode:RAIL_TRANSPORT
      modeCode:ROAD_TRANSPORT
      modeCode:TRANSPORT_MODE_NOT_APPLICABLE
      modeCode:TRANSPORT_MODE_NOT_SPECIFIED
    );
  ];
  sh:property [
    sh:path cargo:modeQualifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
  ], [
    sh:path cargo:modeQualifier;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:modeQualifier;
    sh:in ( cargo:MAIN_CARRIAGE cargo:ON_CARRIAGE cargo:PRE_CARRIAGE );
  ];
  sh:property [
    sh:path cargo:movementTimes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:movementTimes;
    sh:node shwb:MovementTime;
  ];
  sh:property [
    sh:path cargo:movementTimes;
    sh:qualifiedValueShape [
      sh:path cargo:movementMilestone;
      sh:hasValue movementIndicators:SD;
    ];
    sh:qualifiedMinCount 1;
    sh:qualifiedValueShapesDisjoint true;
  ];
  sh:property [
    sh:path cargo:operatingParties;
    sh:maxCount 1;
  ], [
    sh:path cargo:operatingParties;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:operatingParties;
    sh:node shwb:AIR_Party;
  ];
  sh:property [
    sh:path cargo:operatingTransportMeans;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:operatingTransportMeans;
    sh:node shwb:TransportMeans;
  ];
  sh:property [
    sh:path cargo:seal;
    sh:maxCount 1;
  ], [
    sh:path cargo:seal;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:transportIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:transportIdentifier;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:servedServices;
    sh:minCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to booking missing";
  ].

shwb:ULD a sh:NodeShape;
  sh:property [
    sh:path cargo:ownerCode;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:ownerCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ownerCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:tareWeight;
    sh:maxCount 1;
  ], [
    sh:path cargo:tareWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:tareWeight;
    sh:node shwb:Value;
  ];
  sh:property [
    sh:path cargo:uldSerialNumber;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:uldSerialNumber;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:uldTypeCode;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:uldTypeCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:uldTypeCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:Value a sh:NodeShape;
  sh:property [
    sh:path cargo:numericalValue;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:numericalValue;
    sh:severity sh:Info;
    sh:datatype xsd:double;
  ];
  sh:property [
    sh:path cargo:unit;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:unit;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:unit;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:WaybillLineItem a sh:NodeShape;
  sh:property [
    sh:path cargo:chargeableWeight;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:chargeableWeight;
    sh:nodeKind sh:IRI;
