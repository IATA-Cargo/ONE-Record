@prefix shwb: <https://onerecord.iata.org/ns/shapes/waybill#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix terms: <http://purl.org/dc/terms/>.
@prefix cargo: <https://onerecord.iata.org/ns/cargo#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix serviceCode: <https://onerecord.iata.org/ns/code-lists/ServiceCode#>.
@prefix otherChargeCode: <https://onerecord.iata.org/ns/code-lists/OtherChargeCode#>.
@prefix entitlementCode: <https://onerecord.iata.org/ns/code-lists/EntitlementCode#>.
@prefix prepaidCollectIndicator: <https://onerecord.iata.org/ns/code-lists/PrepaidCollectIndicator#>.
@prefix densityGroupCodes: <https://onerecord.iata.org/ns/code-lists/DensityGroupCode#>.
@prefix securityStatus: <https://onerecord.iata.org/ns/code-lists/SecurityStatus#>.
@prefix screeningMethod: <https://onerecord.iata.org/ns/code-lists/ScreeningMethod#>.
@prefix screeningExemption: <https://onerecord.iata.org/ns/code-lists/ScreeningExemption#>.
@prefix regulatedEntityCategoryCode: <https://onerecord.iata.org/ns/code-lists/RegulatedEntityCategoryCode#>.
@prefix modeCode: <https://onerecord.iata.org/ns/code-lists/ModeCode#>.
@prefix rateClassCode: <https://onerecord.iata.org/ns/code-lists/RateClassCode#>.
@prefix participantIdentifiers: <https://onerecord.iata.org/ns/code-lists/ParticipantIdentifier#>.
@prefix movementIndicators: <https://onerecord.iata.org/ns/code-lists/MovementIndicator#>.
@prefix chargeCode: <https://onerecord.iata.org/ns/code-lists/ChargeCode#>.

<https://onerecord.iata.org/ns/shapes/waybill> rdf:type owl:Ontology;
  owl:versionIRI <https://onerecord.iata.org/ns/shapes/waybill/2026-07>;
  dc:description "Waybill shape, described using W3C RDF Schema and the Shapes Constraint Language (SHACL)."@en;
  dc:title "Waybill Shape"@en;
  terms:abstract "Waybill shape for the ONE Record standard, based on the XFWB mapping, cargo and code-lists ontology. Used to validate waybill (AWB / MAWB) data against the ONE Record specifications."@en;
  terms:modified "2026-11-09"^^xsd:date;
  rdfs:comment """Details available on GitHub https://github.com/IATA-Cargo/ONE-Record

2026-07 Initial release.
Code list element URIs must be formed as {{baseURL}}/{{codeListName}}#{{code}}, refer to the specifications https://iata-cargo.github.io/ONE-Record/2026-07/Data-Model/code-lists/#uri-structure.
Blank nodes are not permitted, refer to the specifications https://iata-cargo.github.io/ONE-Record/2026-07/API-Security/implementation-guidelines/#serialization-and-data-formats.

Flagging logic:
Violation: Error in CIMFWB, ISS in CustomsInformation
Warning: Error in XFWB, Code List URI
Info: Data type mismatch

"""@en;
  rdfs:isDefinedBy "https://www.iata.org/one-record/"^^xsd:anyURI;
  rdfs:label "Waybill Shape"@en;
  owl:versionInfo "2026-07"@en.

shwb:DirectOrMasterWaybillTarget a sh:NodeShape;
  sh:targetNode cargo:MASTER, cargo:DIRECT;
  sh:property [
    sh:path [ sh:inversePath cargo:waybillType ];
    sh:node shwb:Waybill;
  ].

shwb:Waybill a sh:NodeShape;
  sh:property [
    sh:path cargo:accountingNotes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:accountingNotes;
    sh:node shwb:AccountingNote;
  ];
  sh:property [
    sh:path cargo:agentReference;
    sh:maxCount 1;
  ], [
    sh:path cargo:agentReference;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:arrivalLocation;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:arrivalLocation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:arrivalLocation;
    sh:node shwb:AIR_Location;
  ];
  sh:property [
    sh:path cargo:carrierChargeCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:carrierChargeCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:carrierChargeCode;
    sh:in (
      chargeCode:CA
      chargeCode:CB
      chargeCode:CC
      chargeCode:CE
      chargeCode:CG
      chargeCode:CH
      chargeCode:CM
      chargeCode:CP
      chargeCode:CX
      chargeCode:CZ
      chargeCode:NC
      chargeCode:NG
      chargeCode:NP
      chargeCode:NT
      chargeCode:NX
      chargeCode:NZ
      chargeCode:PC
      chargeCode:PD
      chargeCode:PE
      chargeCode:PF
      chargeCode:PG
      chargeCode:PH
      chargeCode:PP
      chargeCode:PX
      chargeCode:PZ
    );
  ];
  sh:property [
    sh:path cargo:carrierDeclarationDate;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:carrierDeclarationDate;
    sh:severity sh:Info;
    sh:datatype xsd:dateTime;
  ];
  sh:property [
    sh:path cargo:carrierDeclarationPlace;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:carrierDeclarationPlace;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:carrierDeclarationPlace;
    sh:node shwb:CDP_Location;
  ];
  sh:property [
    sh:path cargo:carrierDeclarationSignature;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:carrierDeclarationSignature;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:consignorDeclarationSignature;
    sh:maxCount 1;
  ], [
    sh:path cargo:consignorDeclarationSignature;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:customsOriginCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:customsOriginCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:customsOriginCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:declaredValueForCarriage;
    sh:maxCount 1;
  ], [
    sh:path cargo:declaredValueForCarriage;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:declaredValueForCarriage;
    sh:node shwb:CurrencyValue;
  ];
  sh:property [
    sh:path cargo:declaredValueForCustoms;
    sh:maxCount 1;
  ], [
    sh:path cargo:declaredValueForCustoms;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:declaredValueForCustoms;
    sh:node shwb:CurrencyValue;
  ];
  sh:property [
    sh:path cargo:departureLocation;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:departureLocation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:departureLocation;
    sh:node shwb:AIR_Location;
  ];
  sh:property [
    sh:path cargo:destinationCharges;
    sh:maxCount 1;
  ], [
    sh:path cargo:destinationCharges;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:destinationCharges;
    sh:node shwb:CurrencyValue;
  ];
  sh:property [
    sh:path cargo:destinationCurrencyRate;
    sh:maxCount 1;
  ], [
    sh:path cargo:destinationCurrencyRate;
    sh:severity sh:Info;
    sh:datatype xsd:double;
  ];
  sh:property [
    sh:path cargo:otherCharges;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:otherCharges;
    sh:node shwb:OtherCharge;
  ];
  sh:property [
    sh:path cargo:otherChargesIndicator;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:otherChargesIndicator;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:otherChargesIndicator;
    sh:in ( prepaidCollectIndicator:C prepaidCollectIndicator:P );
  ];
  sh:property [
    sh:path cargo:otherIdentifiers;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:otherIdentifiers;
    sh:node shwb:OtherIdentifier;
  ];
  sh:property [
    sh:path cargo:referredBookingOption;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:referredBookingOption;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:referredBookingOption;
    sh:node shwb:Booking;
  ];
  sh:property [
    sh:path cargo:serviceCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:serviceCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:serviceCode;
    sh:in (
      serviceCode:A
      serviceCode:B
      serviceCode:C
      serviceCode:D
      serviceCode:E
      serviceCode:F
      serviceCode:G
      serviceCode:H
      serviceCode:I
      serviceCode:J
      serviceCode:P
      serviceCode:S
      serviceCode:T
      serviceCode:X
    );
  ];
  sh:property [
    sh:path cargo:shipment;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:shipment;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:shipment;
    sh:node shwb:Shipment;
  ];
  sh:property [
    sh:path cargo:shippingInfo;
    sh:maxCount 1;
  ], [
    sh:path cargo:shippingInfo;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:shippingRefNo;
    sh:maxCount 1;
  ], [
    sh:path cargo:shippingRefNo;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:taxAmount;
    sh:maxCount 1;
  ], [
    sh:path cargo:taxAmount;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:taxAmount;
    sh:node shwb:CurrencyValue;
  ];
  sh:property [
    sh:path cargo:valuationCharge;
    sh:maxCount 1;
  ], [
    sh:path cargo:valuationCharge;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:valuationCharge;
    sh:node shwb:CurrencyValue;
  ];
  sh:property [
    sh:path cargo:waybillLineItems;
    sh:minCount 1;
  ], [
    sh:path cargo:waybillLineItems;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:waybillLineItems;
    sh:node shwb:WaybillLineItem;
  ];
  sh:property [
    sh:path cargo:waybillNumber;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:waybillNumber;
    sh:pattern "^[0-9]{8}$";
  ];
  sh:property [
    sh:path cargo:waybillPrefix;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:waybillPrefix;
    sh:pattern "^[0-9]{3}$";
  ];
  sh:property [
    sh:path cargo:waybillType;
    sh:minCount 1;
    sh:maxCount 1;
  ];
  sh:property [
    sh:path cargo:weightValuationIndicator;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:weightValuationIndicator;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:weightValuationIndicator;
    sh:in ( prepaidCollectIndicator:C prepaidCollectIndicator:P );
  ].

shwb:AccountingNote a sh:NodeShape;
  sh:property [
    sh:path cargo:accountingNoteIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:accountingNoteIdentifier;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:accountingNoteText;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:accountingNoteText;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:AccountNumber a sh:NodeShape;
  sh:property [
    sh:path cargo:accountNumberType;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:accountNumberType;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:textualValue;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:textualValue;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:ActivitySequence a sh:NodeShape;
  sh:property [
    sh:path cargo:activity;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:sequenceNumber;
    sh:maxCount 1;
  ], [
    sh:path cargo:sequenceNumber;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:Address a sh:NodeShape;
  sh:property [
    sh:path cargo:cityCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:cityCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:cityCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:cityName;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:cityName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:country;
    sh:maxCount 1;
  ], [
    sh:path cargo:country;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:country;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:postOfficeBox;
    sh:maxCount 1;
  ], [
    sh:path cargo:postOfficeBox;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:regionCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:regionCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:regionCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:streetAddressLines;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:textualPostCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:textualPostCode;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:AIR_Location a sh:NodeShape;
  sh:property [
    sh:path cargo:locationCodes;
    sh:minCount 1;
  ], [
    sh:path cargo:locationCodes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:locationCodes;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:locationName;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:locationType;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationType;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:AIR_Party a sh:NodeShape;
  sh:property [
    sh:path cargo:partyDetails;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyDetails;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyDetails;
    sh:node shwb:Carrier;
  ];
  sh:property [
    sh:path cargo:partyRole;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyRole;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyRole;
    sh:hasValue participantIdentifiers:AIR;
  ].

shwb:Booking a sh:NodeShape;
  sh:property [
    sh:path cargo:activitySequences;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:activitySequences;
    sh:node shwb:ActivitySequence;
  ], [
    sh:path ( cargo:activitySequences cargo:activity );
    sh:qualifiedValueShape shwb:RoutingTransportMovement;
    sh:qualifiedMinCount 1;
    sh:message "Booking needs at least one TransportMovement with arrival location, SD movement time and an AIR operating party with airline code";
  ];
  sh:property [
    sh:path cargo:bookingShipmentDetails;
    sh:maxCount 1;
  ], [
    sh:path cargo:bookingShipmentDetails;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:bookingShipmentDetails;
    sh:node shwb:BookingShipment;
  ];
  sh:property [
    sh:path cargo:carrierProduct;
    sh:maxCount 1;
  ], [
    sh:path cargo:carrierProduct;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:carrierProduct;
    sh:node shwb:CarrierProduct;
  ];
  sh:property [
    sh:path cargo:issuedForWaybill;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to waybill missing";
  ].

shwb:BookingShipment a sh:NodeShape;
  sh:property [
    sh:path cargo:densityGroupCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:densityGroupCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:densityGroupCode;
    sh:severity sh:Info;
    sh:in (
      densityGroupCodes:0
      densityGroupCodes:1
      densityGroupCodes:2
      densityGroupCodes:3
      densityGroupCodes:4
      densityGroupCodes:5
      densityGroupCodes:6
      densityGroupCodes:7
      densityGroupCodes:8
      densityGroupCodes:9
      densityGroupCodes:10
    );
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:Carrier a sh:NodeShape;
  sh:property [
    sh:path cargo:airlineCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:airlineCode;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:CarrierProduct a sh:NodeShape;
  sh:property [
    sh:path cargo:productCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:productCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:productCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shwb:CDP_Location a sh:NodeShape;
  sh:property [
    sh:path cargo:locationName;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:Company a sh:NodeShape;
  sh:property [
    sh:path cargo:basedAtLocation;
    sh:maxCount 1;
  ], [
    sh:path cargo:basedAtLocation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:basedAtLocation;
    sh:node shwb:PAR_Location;
  ];
  sh:property [
    sh:path cargo:contactPersons;
    sh:maxCount 1;
  ], [
    sh:path cargo:contactPersons;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contactPersons;
    sh:node shwb:PAR_Person;
  ];
  sh:property [
    sh:path cargo:iataCargoAgentCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:iataCargoAgentCode;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:iataCargoAgentLocationIdentifier;
    sh:maxCount 1;
  ], [
    sh:path cargo:iataCargoAgentLocationIdentifier;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:name;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:name;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:ContactDetail a sh:NodeShape;
  sh:property [
    sh:path cargo:contactDetailType;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:contactDetailType;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contactDetailType;
    sh:severity sh:Warning;
    sh:in ( cargo:ALTERNATE_EMAIL_ADDRESS cargo:ALTERNATE_PHONE_NUMBER cargo:EMAIL_ADDRESS cargo:FAX_NUMBER cargo:PHONE_NUMBER cargo:TELEX cargo:WEBSITE );
  ];
  sh:property [
    sh:path cargo:textualValue;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:textualValue;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shwb:CurrencyValue a sh:NodeShape;
  sh:property [
    sh:path cargo:currencyUnit;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:currencyUnit;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:currencyUnit;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:numericalValue;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:numericalValue;
    sh:severity sh:Info;
    sh:datatype xsd:double;
  ].

shwb:CustomsInformation a sh:NodeShape;
  sh:property [
    sh:path cargo:contentCode;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:contentCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contentCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:country;
    sh:maxCount 1;
  ], [
    sh:path cargo:country;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:country;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:otherCustomsInformation;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:otherCustomsInformation;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:ociLineNumber;
    sh:maxCount 1;
  ], [
    sh:path cargo:ociLineNumber;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:subjectCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:subjectCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:subjectCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:subjectCode;
    sh:not [ sh:pattern "#ISS$" ];
    sh:message "CustomsInformation must not be used for Security Information (ISS) - use SecurityDeclaration instead";
  ], [
    sh:path ( cargo:subjectCode cargo:code );
    sh:not [ sh:pattern "ISS$" ];
    sh:message "CustomsInformation must not be used for Security Information (ISS) - use SecurityDeclaration instead";
  ].

