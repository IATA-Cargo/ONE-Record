    sh:node shwb:ULD;
  ].

shwb:SecurityDeclaration a sh:NodeShape;
  sh:property [
    sh:path cargo:regulatedEntityIssuer;
    sh:node shwb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntityIssuer;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityIssuer;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:regulatedEntityAcceptor;
    sh:node shwb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntityAcceptor;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:regulatedEntitiesReceivedFrom;
    sh:node shwb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntitiesReceivedFrom;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:issuedBy;
    sh:node shwb:CSD_Person;
  ], [
    sh:path cargo:issuedBy;
    sh:maxCount 1;
  ], [
    sh:path cargo:issuedBy;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:issuedOn;
    sh:maxCount 1;
  ], [
    sh:path cargo:issuedOn;
    sh:severity sh:Info;
    sh:datatype xsd:dateTime;
  ], [
    sh:path cargo:securityStatus;
    sh:minCount 1;
  ], [
    sh:path cargo:securityStatus;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:securityStatus;
    sh:in (
      securityStatus:NSC
      securityStatus:SCO
      securityStatus:SHR
      securityStatus:SPX
    );
  ], [
    sh:path cargo:screeningMethods;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:screeningMethods;
    sh:in (
      screeningMethod:AOM
      screeningMethod:CMD
      screeningMethod:EDD
      screeningMethod:EDS
      screeningMethod:ETD
      screeningMethod:PHS
      screeningMethod:VCK
      screeningMethod:XRY
    );
  ], [
    sh:path cargo:groundsForExemption;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:groundsForExemption;
    sh:in (
      screeningExemption:BIOM
      screeningExemption:DIPL
      screeningExemption:LFSM
      screeningExemption:MAIL
      screeningExemption:NUCL
      screeningExemption:SMUS
      screeningExemption:TRNS
    );
  ];
  sh:property [
    sh:path cargo:additionalSecurityInformation;
    sh:maxCount 1;
  ], [
    sh:path cargo:additionalSecurityInformation;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:issuedForShipment;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to shipment is missing";
  ].

shwb:RegulatedEntity a sh:NodeShape;
  sh:property [
    sh:path cargo:regulatedEntityCategory;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityCategory;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:regulatedEntityCategory;
    sh:in (
      regulatedEntityCategoryCode:AO
      regulatedEntityCategoryCode:KC
      regulatedEntityCategoryCode:RA
      regulatedEntityCategoryCode:RC
    );
  ];
  sh:property [
    sh:path cargo:regulatedEntityIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityIdentifier;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ], [
    sh:path cargo:regulatedEntityIdentifier;
    sh:pattern "^[A-Z]{2}/[^/]+$";
    sh:message "regulatedEntityIdentifier must be CC/number";
  ];
  sh:property [
    sh:path cargo:regulatedEntityExpiryDate;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityExpiryDate;
    sh:severity sh:Info;
    sh:datatype xsd:dateTime;
  ].

shwb:CSD_Person a sh:NodeShape;
  sh:property [
    sh:path cargo:firstName;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:firstName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:lastName;
    sh:maxCount 1;
  ], [
    sh:path cargo:lastName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

