  ], [
    sh:path cargo:lineItemNumber;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:lineItemPackages;
    sh:minCount 1;
  ], [
    sh:path cargo:lineItemPackages;
    sh:nodeKind sh:IRI;
