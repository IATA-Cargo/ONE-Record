  sh:property [
    sh:path cargo:ratePercentage;
    sh:maxCount 1;
  ], [
    sh:path cargo:ratePercentage;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ratePercentage;
    sh:node shwb:Value;
  ];
  sh:property [
    sh:path cargo:rateSlac;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateSlac;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:rateVolume;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateVolume;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rateVolume;
    sh:node shwb:Value;
