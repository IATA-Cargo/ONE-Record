  ];
  sh:property [
    sh:path cargo:rateClassCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateClassCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rateClassCode;
    sh:in (
      rateClassCode:B
      rateClassCode:C
      rateClassCode:E
      rateClassCode:K
      rateClassCode:M
      rateClassCode:N
      rateClassCode:P
      rateClassCode:Q
      rateClassCode:R
      rateClassCode:S
      rateClassCode:U
      rateClassCode:W
      rateClassCode:X
      rateClassCode:Y
    );
  ];
  sh:property [
    sh:path cargo:rateClassCodeBasic;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateClassCodeBasic;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rateClassCodeBasic;
    sh:in (
      rateClassCode:C
      rateClassCode:M
      rateClassCode:N
      rateClassCode:Q
      rateClassCode:U
    );
  ];
  sh:property [
    sh:path cargo:rateGrossWeight;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateGrossWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rateGrossWeight;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:ratePercentage;
    sh:maxCount 1;
  ], [
    sh:path cargo:ratePercentage;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ratePercentage;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:rateSlac;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateSlac;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:rateVolume;
    sh:maxCount 1;
  ], [
    sh:path cargo:rateVolume;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rateVolume;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:rcp;
    sh:maxCount 1;
  ], [
    sh:path cargo:rcp;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:rcp;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:uldRateClassType;
    sh:maxCount 1;
  ], [
    sh:path cargo:uldRateClassType;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:uldRateClassType;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:uldReferences;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:uldReferences;
    sh:node shhb:ULD;
  ].

shhb:ULD a sh:NodeShape;
  sh:property [
    sh:path cargo:ownerCode;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:ownerCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ownerCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:tareWeight;
    sh:maxCount 1;
  ], [
    sh:path cargo:tareWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:tareWeight;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:uldSerialNumber;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:uldSerialNumber;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:uldTypeCode;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:uldTypeCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:uldTypeCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shhb:SecurityDeclaration a sh:NodeShape;
  sh:property [
    sh:path cargo:regulatedEntityIssuer;
    sh:node shhb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntityIssuer;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityIssuer;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:regulatedEntityAcceptor;
    sh:node shhb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntityAcceptor;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:regulatedEntitiesReceivedFrom;
    sh:node shhb:RegulatedEntity;
  ], [
    sh:path cargo:regulatedEntitiesReceivedFrom;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:issuedBy;
    sh:node shhb:CSD_Person;
  ], [
    sh:path cargo:issuedBy;
    sh:maxCount 1;
  ], [
    sh:path cargo:issuedBy;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ];
  sh:property [
    sh:path cargo:issuedOn;
    sh:maxCount 1;
  ], [
    sh:path cargo:issuedOn;
    sh:severity sh:Info;
    sh:datatype xsd:dateTime;
  ], [
    sh:path cargo:securityStatus;
    sh:minCount 1;
  ], [
    sh:path cargo:securityStatus;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:securityStatus;
    sh:in (
      securityStatus:NSC
      securityStatus:SCO
      securityStatus:SHR
      securityStatus:SPX
    );
  ], [
    sh:path cargo:screeningMethods;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:screeningMethods;
    sh:in (
      screeningMethod:AOM
      screeningMethod:CMD
      screeningMethod:EDD
      screeningMethod:EDS
      screeningMethod:ETD
      screeningMethod:PHS
      screeningMethod:VCK
      screeningMethod:XRY
    );
  ], [
    sh:path cargo:groundsForExemption;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:groundsForExemption;
    sh:in (
      screeningExemption:BIOM
      screeningExemption:DIPL
      screeningExemption:LFSM
      screeningExemption:MAIL
      screeningExemption:NUCL
      screeningExemption:SMUS
      screeningExemption:TRNS
    );
  ];
  sh:property [
    sh:path cargo:additionalSecurityInformation;
    sh:maxCount 1;
  ], [
    sh:path cargo:additionalSecurityInformation;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:issuedForShipment;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to shipment missing";
  ].

shhb:RegulatedEntity a sh:NodeShape;
  sh:property [
    sh:path cargo:regulatedEntityCategory;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityCategory;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:regulatedEntityCategory;
    sh:in (
      regulatedEntityCategoryCode:AO
      regulatedEntityCategoryCode:KC
      regulatedEntityCategoryCode:RA
      regulatedEntityCategoryCode:RC
    );
  ];
  sh:property [
    sh:path cargo:regulatedEntityIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityIdentifier;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ], [
    sh:path cargo:regulatedEntityIdentifier;
    sh:pattern "^[A-Z]{2}/[^/]+$";
    sh:message "regulatedEntityIdentifier must be CC/number";
  ];
  sh:property [
    sh:path cargo:regulatedEntityExpiryDate;
    sh:maxCount 1;
  ], [
    sh:path cargo:regulatedEntityExpiryDate;
    sh:severity sh:Info;
    sh:datatype xsd:dateTime;
  ].

shhb:CSD_Person a sh:NodeShape;
  sh:property [
    sh:path cargo:firstName;
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path cargo:firstName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:lastName;
    sh:maxCount 1;
  ], [
    sh:path cargo:lastName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].