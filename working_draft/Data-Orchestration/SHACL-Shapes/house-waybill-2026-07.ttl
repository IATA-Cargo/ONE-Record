shhb:OtherIdentifier a sh:NodeShape;
  sh:property [
    sh:path cargo:otherIdentifierType;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:otherIdentifierType;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:textualValue;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:textualValue;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shhb:P_Dimensions a sh:NodeShape;
  sh:property [
    sh:path cargo:height;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:height;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:height;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:length;
    sh:minCount 1;
    sh:maxCount 1;
