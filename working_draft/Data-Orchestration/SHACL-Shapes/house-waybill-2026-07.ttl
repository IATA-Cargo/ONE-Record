    sh:path cargo:firstName;
    sh:maxCount 1;
  ], [
    sh:path cargo:firstName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:lastName;
    sh:maxCount 1;
  ], [
    sh:path cargo:lastName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shhb:Party a sh:NodeShape;
  sh:property [
    sh:path cargo:accountNumbers;
    sh:maxCount 1;
  ], [
    sh:path cargo:accountNumbers;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:accountNumbers;
    sh:node shhb:AccountNumber;
  ];
  sh:property [
    sh:path cargo:otherIdentifiers;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:otherIdentifiers;
    sh:node shhb:OtherIdentifier;
  ];
  sh:property [
    sh:path cargo:partyDetails;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyDetails;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyDetails;
    sh:node shhb:Company;
  ];
  sh:property [
    sh:path cargo:partyRole;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:partyRole;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:partyRole;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shhb:Piece a sh:NodeShape;
  sh:property [
    sh:path [ sh:zeroOrMorePath cargo:containedPieces ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:or (
      [ sh:property [ sh:path ( cargo:contentProducts cargo:hsCode ) ; sh:minCount 1 ] ]
      [ sh:property [ sh:path ( cargo:containedItems cargo:ofProduct cargo:hsCode ) ; sh:minCount 1 ] ]
    ) ] ;
    sh:severity sh:Warning;
    sh:message "No HS code connected to Piece - Mandatory for FZB-based HAWB" ;
  ];
  sh:property [
    sh:path cargo:contentProductionCountry;
    sh:maxCount 1;
  ], [
    sh:path cargo:contentProductionCountry;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contentProductionCountry;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:contentProducts;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:contentProducts;
    sh:node shhb:Product;
  ];
  sh:property [
    sh:path cargo:dimensions;
    sh:maxCount 1;
  ], [
    sh:path cargo:dimensions;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:dimensions;
    sh:node shhb:P_Dimensions;
  ];
  sh:property [
    sh:path cargo:goodsDescription;
    sh:maxCount 1;
  ], [
    sh:path cargo:goodsDescription;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:slac;
    sh:maxCount 1;
  ], [
    sh:path cargo:slac;
    sh:severity sh:Info;
    sh:datatype xsd:integer;
  ];
  sh:property [
    sh:path cargo:specialHandlingCodes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:specialHandlingCodes;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:containedItems;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:containedItems;
    sh:node shhb:Item;
  ];
  sh:property [
    sh:path cargo:ofShipment;
    sh:minCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to shipment missing";
  ].

shhb:LineItemPiece a sh:NodeShape;
  sh:property [
    sh:path cargo:dimensions;
    sh:maxCount 1;
  ], [
    sh:path cargo:dimensions;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:dimensions;
    sh:node shhb:P_Dimensions;
  ];
  sh:property [
    sh:path cargo:ofShipment;
    sh:minCount 1;
    sh:severity sh:Info;
    sh:message "Line item piece not connected to a shipment";
  ].

shhb:Item a sh:NodeShape;
  sh:property [
    sh:path cargo:ofProduct;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:ofProduct;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:ofProduct;
    sh:node shhb:Product;
  ];
  sh:property [
    sh:path cargo:productionCountry;
    sh:maxCount 1;
  ], [
    sh:path cargo:productionCountry;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:productionCountry;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shhb:Product a sh:NodeShape;
  sh:property [
    sh:path cargo:commodityItemNumber;
    sh:maxCount 1;
  ], [
    sh:path cargo:commodityItemNumber;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:hsCode;
    sh:maxCount 1;
  ], [
    sh:path cargo:hsCode;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:hsCode;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ].

shhb:Shipment a sh:NodeShape;
  sh:node [
    sh:or ( [ sh:property [
      sh:path cargo:goodsDescription;
      sh:minCount 1;
    ] ] [ sh:property [
      sh:path [ sh:oneOrMorePath cargo:pieces ];
      sh:minCount 1;
      sh:node [ sh:property [
        sh:path cargo:goodsDescription;
        sh:minCount 1;
      ] ];
    ] ] );
    sh:message "goodsDescription on either shipment or piece is mandatory.";
  ];
  sh:property [
    sh:path cargo:customsInformation;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:customsInformation;
    sh:node shhb:CustomsInformation;
  ];
  sh:property [
    sh:path cargo:goodsDescription;
    sh:maxCount 1;
  ], [
    sh:path cargo:goodsDescription;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:insurance;
    sh:maxCount 1;
  ], [
    sh:path cargo:insurance;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:insurance;
    sh:node shhb:Insurance;
  ];
  sh:property [
    sh:path cargo:involvedParties;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:involvedParties;
    sh:node shhb:Party;
  ];
  sh:property [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:SHP;
    ];
    sh:qualifiedMinCount 1;
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
    sh:severity sh:Warning;
    sh:message "SHP mandatory for FZB-based HAWB";
  ], [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:CNE;
    ];
    sh:qualifiedMinCount 1;
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
    sh:severity sh:Warning;
    sh:message "CNE mandatory for FZB-based HAWB";
  ], [
    sh:path cargo:involvedParties;
    sh:or ( [ sh:not [
      sh:path cargo:partyRole;
      sh:minCount 1;
      sh:in ( participantIdentifiers:SHP participantIdentifiers:CNE );
    ] ] [
      sh:path ( cargo:partyDetails cargo:basedAtLocation cargo:address cargo:streetAddressLines );
      sh:minCount 1;
    ] );
    sh:message "Shipper (SHP) and consignee (CNE) address requires a street address line";
  ], [
    sh:path cargo:involvedParties;
    sh:qualifiedValueShape [
      sh:path cargo:partyRole;
      sh:hasValue participantIdentifiers:AGT;
    ];
    sh:qualifiedMaxCount 1;
    sh:qualifiedValueShapesDisjoint true;
  ];
  sh:property [
    sh:path cargo:pieces;
    sh:minCount 1;
  ], [
    sh:path cargo:pieces;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:pieces;
    sh:node shhb:Piece;
  ];
  sh:property [
    sh:path cargo:textualHandlingInstructions;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:totalGrossWeight;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:totalGrossWeight;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:totalGrossWeight;
    sh:node shhb:Value;
  ];
  sh:property [
    sh:path cargo:totalVolume;
    sh:maxCount 1;
  ], [
    sh:path cargo:totalVolume;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:totalVolume;
    sh:node shhb:Value;
  ];
  sh:property [ sh:path cargo:securityDeclarations ], [
    sh:path cargo:securityDeclarations;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:securityDeclarations;
    sh:node shhb:SecurityDeclaration;
  ];
  sh:property [
    sh:path cargo:waybill;
    sh:minCount 1;
    sh:maxCount 1;
    sh:severity sh:Warning;
    sh:message "Backlink to waybill missing";
  ].

shhb:Value a sh:NodeShape;
  sh:property [
    sh:path cargo:numericalValue;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path cargo:numericalValue;
    sh:severity sh:Info;
