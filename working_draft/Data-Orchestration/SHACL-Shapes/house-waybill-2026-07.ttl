    sh:path cargo:width;
    sh:node shhb:Value;
  ].

shhb:PAR_Location a sh:NodeShape;
  sh:property [
    sh:path cargo:address;
    sh:maxCount 1;
  ], [
    sh:path cargo:address;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:address;
    sh:node shhb:Address;
  ];
  sh:property [
    sh:path cargo:locationCodes;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationCodes;
    sh:nodeKind sh:IRI;
    sh:message "Blank node not permitted";
  ], [
    sh:path cargo:locationCodes;
    sh:severity sh:Warning;
    sh:pattern "#[A-Za-z0-9_-]+$";
    sh:message "Malformed code list URI";
  ];
  sh:property [
    sh:path cargo:locationName;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationName;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ];
  sh:property [
    sh:path cargo:locationType;
    sh:maxCount 1;
  ], [
    sh:path cargo:locationType;
    sh:severity sh:Info;
    sh:datatype xsd:string;
  ].

shhb:PAR_Person a sh:NodeShape;
